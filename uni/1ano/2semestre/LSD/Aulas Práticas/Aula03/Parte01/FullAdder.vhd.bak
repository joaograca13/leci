library IEEE;
use IEEE.STD_LOGIC_1164.all;

entity FullAdder is
    port(
        a, b, cin : in std_logic;  -- Entradas
        s, cout   : out std_logic  -- Saídas
    );
end FullAdder;

architecture Behavioral of FullAdder is
begin
    process(a, b, cin)
    begin
        -- Equação da soma
        s <= a XOR b XOR cin;

        -- Equação do carry-out
        cout <= (a AND b) OR (a AND cin) OR (b AND cin);
    end process;
end Behavioral;