-- Inclua as bibliotecas necessárias
library IEEE;
use IEEE.STD_LOGIC_1164.all;

entity Adder4 is
    port(
        a, b : in std_logic_vector(3 downto 0); -- Entradas de 4 bits
        cin  : in std_logic;                    -- Carry-in
        s    : out std_logic_vector(3 downto 0); -- Saídas de soma de 4 bits
        cout : out std_logic                     -- Carry-out final
    );
end Adder4;

architecture Structural of Adder4 is
    -- Declaração do vetor de carry interno para conectar os somadores
    signal carryOut : std_logic_vector(3 downto 0);
begin
    -- Somador do bit menos significativo (LSB)
    bit0: entity work.FullAdder(Behavioral)
        port map(
            a    => a(0),
            b    => b(0),
            cin  => cin,
            s    => s(0),
            cout => carryOut(0)
        );

    -- Somador do bit 1
    bit1: entity work.FullAdder(Behavioral)
        port map(
            a    => a(1),
            b    => b(1),
            cin  => carryOut(0),
            s    => s(1),
            cout => carryOut(1)
        );

    -- Somador do bit 2
    bit2: entity work.FullAdder(Behavioral)
        port map(
            a    => a(2),
            b    => b(2),
            cin  => carryOut(1),
            s    => s(2),
            cout => carryOut(2)
        );

    -- Somador do bit mais significativo (MSB)
    bit3: entity work.FullAdder(Behavioral)
        port map(
            a    => a(3),
            b    => b(3),
            cin  => carryOut(2),
            s    => s(3),
            cout => cout  -- Carry-out final
        );

end Structural;
